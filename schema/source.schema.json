{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "url",
  "publisher",
  "kind",
  "label",
  "accessed"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "url": {
   "type": "string",
   "pattern": "^https://"
  },
  "publisher": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "filing",
    "company",
    "press",
    "dataset",
    "government"
   ]
  },
  "filing_form": {
   "type": "string"
  },
  "locator": {
   "type": "string"
  },
  "label": {
   "type": "string"
  },
  "published": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "accessed": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  }
 }
}
