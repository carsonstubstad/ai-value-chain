{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "date",
  "kind",
  "companies",
  "summary",
  "confidence",
  "sources"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "kind": {
   "enum": [
    "new_deal",
    "amount_change",
    "basis_change",
    "status_change",
    "filing",
    "other"
   ]
  },
  "companies": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9-]*$"
   }
  },
  "deal": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "summary": {
   "type": "string"
  },
  "confidence": {
   "enum": [
    "filed",
    "company_stated",
    "reported",
    "rumored"
   ]
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9-]*$"
   }
  }
 }
}
