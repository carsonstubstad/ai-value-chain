{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "company",
  "metric",
  "period",
  "value_usd_low",
  "basis",
  "confidence",
  "as_of",
  "sources"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "company": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "metric": {
   "enum": [
    "revenue",
    "segment_revenue",
    "capex",
    "ai_revenue_run_rate"
   ]
  },
  "segment": {
   "type": "string"
  },
  "period": {
   "type": "string",
   "pattern": "^(FY|CY)\\d{4}(Q[1-4])?$"
  },
  "value_usd_low": {
   "type": "number",
   "minimum": 0
  },
  "value_usd_high": {
   "type": "number",
   "minimum": 0
  },
  "basis": {
   "enum": [
    "committed",
    "paid",
    "estimated"
   ]
  },
  "confidence": {
   "enum": [
    "filed",
    "company_stated",
    "reported",
    "rumored"
   ]
  },
  "as_of": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9-]*$"
   }
  }
 }
}
