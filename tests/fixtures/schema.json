{
  "type": "object",
  "required": ["id", "amount_basis", "confidence", "as_of", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "amount_usd_low": {"type": "number", "minimum": 0},
    "amount_basis": {"enum": ["committed", "paid", "estimated"]},
    "confidence": {"enum": ["filed", "company_stated", "reported", "rumored"]},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "summary": {"type": "string"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}}
  }
}
